<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_configure_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/configure_use_soonest_active"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_configure_use_soonest"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_configure_or_pick"
        android:textColor="@color/widget_text_muted"
        android:paddingBottom="8dp" />

    <ProgressBar
        android:id="@+id/configure_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/configure_empty_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_configure_no_countdowns"
        android:visibility="gone" />

    <ListView
        android:id="@+id/configure_countdown_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
