# Backend API base URL. Never hardcode this in source (see eslint.config.js's
# no-restricted-syntax rule) — set it per environment:
#   local dev:  http://localhost:8000
#   staging:    https://<your-render-service>.onrender.com
#   production: same, or your custom domain if you put one in front of Render
VITE_API_BASE_URL=http://localhost:8000
